{
  "name": "pnptv-intro-curtain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PNPtv! video intro curtain \u2014 title card + legal disclaimer, props-driven, orientation-aware, headlessly renderable.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "render": "node render/render-intro.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
